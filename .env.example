# Public devnet RPC used by the browser wallet connection
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server side RPC used by the test money route
SOLANA_RPC_URL=https://api.devnet.solana.com

# Six decimal devnet USDC mint used by the deployed Ajo Circles config
TEST_MINT_ADDRESS=replace_with_devnet_test_mint

# JSON array secret key for the funded devnet authority that can mint test USDC and send SOL
TEST_MONEY_AUTHORITY_SECRET_KEY=[replace_with_secret_key_bytes]

# Test money limits and amounts
TEST_MONEY_RATE_LIMIT_MS=3600000
TEST_MONEY_USDC_AMOUNT=100000000
TEST_MONEY_SOL_LAMPORTS=10000000
